{
  "extends": "../../../config/tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022"
    ],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": [
      "node"
    ],
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "strict-ts": [
        "../../../src/index.ts"
      ],
      "strict-ts/safe": [
        "../../../src/safe/index.ts"
      ]
    }
  },
  "include": [
    "*.ts",
    "minio/*.ts"
  ]
}
